# Database (Neon Postgres)
DATABASE_URL=your-postgresql-connection-string
# Only for a database with a self-signed TLS certificate (Neon doesn't need this)
# DATABASE_SSL_NO_VERIFY=true

# Only used by the seed scripts in api/ (setup_db.ts, seed-database.ts)
# SUPABASE_URL=your-supabase-project-url
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin CMS login (/admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
# Signs admin sessions. Required in production (32+ chars), e.g. `openssl rand -hex 32`.
# Without it the public site still runs, but admin access is disabled.
ADMIN_JWT_SECRET=

# Where admin file uploads are stored — mount a persistent volume here in Docker
UPLOAD_DIR=./uploads

# Loops email marketing
LOOPS_API_KEY=your_loops_api_key_here

# Environment (development | production)
NODE_ENV=production
